# Copier ce fichier en ".env" et adapter les valeurs, puis ne jamais committer le ".env" reel.

# --- Commun ---
PUID=1000
PGID=1000
TZ=Europe/Paris
DEDIEUFY_ROOT=/volume1/docker/dedieufy
MUSIC_PATH=/volume1/music

# --- Navidrome ---
NAVIDROME_PORT=4533
ND_LOGLEVEL=info
ND_SESSIONTIMEOUT=24h
ND_SCANNER_SCANONSTARTUP=true
ND_SCANNER_SCHEDULE=@every 1h
ND_ENABLEINSIGHTSCOLLECTOR=false
ND_LASTFM_APIKEY=changeme
ND_LASTFM_SECRET=changeme

# --- Releases (nouveau service) ---
RELEASES_PORT=8090
